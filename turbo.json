{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "loose",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "TOTP_ENCRYPTION_KEY",
    "TOTP_ENCRYPTION_PREVIOUS_KEYS",
    "TOTP_ISSUER",
    "PLATFORM_ADMIN_EMAIL",
    "PLATFORM_ADMIN_PASSWORD",
    "PLATFORM_ADMIN_NAME",
    "WEB_ORIGIN",
    "API_HOST",
    "API_PORT",
    "API_INTERNAL_URL",
    "NEXT_PUBLIC_API_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "db:migrate": {
      "dependsOn": ["db:generate"],
      "cache": false
    },
    "db:migrate:deploy": {
      "dependsOn": ["db:generate"],
      "cache": false
    },
    "db:migrate:status": {
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "db:setup": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "admin:bootstrap": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "check:architecture": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/**/*.ts",
        "$TURBO_ROOT$/apps/**/*.tsx",
        "$TURBO_ROOT$/apps/**/*.mjs",
        "$TURBO_ROOT$/docker/**",
        "$TURBO_ROOT$/docker-compose.yml"
      ]
    }
  }
}
