# Copy to `.env` at the repository root. Never commit `.env`.
# Generate JWT_ACCESS_SECRET, TOTP_ENCRYPTION_KEY, and a database password with:
#   pnpm secrets:generate

NODE_ENV=development

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
API_BODY_LIMIT=100kb
# Express `trust proxy`: false | true | hop count | subnet list (e.g. loopback,uniquelocal)
TRUST_PROXY=loopback

# Host-based development. Docker Compose overrides these inside containers to use service DNS.
DATABASE_URL=postgresql://techwin:techwin_dev_change_me@127.0.0.1:5432/techwin
DATABASE_POOL_MAX=10
REDIS_URL=redis://127.0.0.1:6379

WEB_ORIGIN=http://localhost:3000
# Optional extra origins, comma-separated. WEB_ORIGIN is always allowed.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000

JWT_ACCESS_SECRET=replace-this-with-output-of-pnpm-secrets-generate-at-least-48-chars
JWT_ISSUER=techwin-api
JWT_AUDIENCE=techwin-platform-admin

# Base64-encoded 32-byte key. Do not replace this in an environment that already
# has enrolled administrators; rotate by moving the old key to TOTP_ENCRYPTION_PREVIOUS_KEYS.
TOTP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# TOTP_ENCRYPTION_PREVIOUS_KEYS=
TOTP_ISSUER=Techwin

# Optional. Defaults to true in production, false otherwise.
# COOKIE_SECURE=false
# SWAGGER_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=300
LOG_LEVEL=info
LOG_PRETTY=true

# --- Super Admin seed (CLI / `pnpm db:seed` only; never used by the HTTP API or web app) ---
# Never expose these as NEXT_PUBLIC_*. The seed hashes the password, issues a
# new TOTP secret, and revokes previous sessions on every run.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace_with_a_strong_password
PLATFORM_ADMIN_NAME=Super Admin

# --- Web (Next.js rewrite target; browser still calls the web origin) ---
API_INTERNAL_URL=http://localhost:4000
# Leave empty so the browser uses same-origin `/api/v1` (recommended).
NEXT_PUBLIC_API_BASE_URL=

# --- Docker Compose interpolation (api/web containers ignore host DATABASE_URL/REDIS_URL) ---
POSTGRES_USER=techwin
POSTGRES_PASSWORD=techwin_dev_change_me
POSTGRES_DB=techwin
WEB_PORT=3000
API_PUBLISH_PORT=4000
