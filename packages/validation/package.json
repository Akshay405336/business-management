{
  "name": "@techwin/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas shared by the Techwin API (request validation) and web app (form validation).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@techwin/eslint-config": "workspace:*",
    "@techwin/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
}
