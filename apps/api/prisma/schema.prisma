// Techwin database schema. The connection URL is configured in prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformAdminRole {
  SUPER_ADMIN
  ORGANIZATION_MEMBER
}

enum PlatformAdminStatus {
  ACTIVE
  DISABLED
}

enum PlatformSessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  REVOKED
  REFRESH_TOKEN_REUSE
  CREDENTIALS_RESET
}

enum PlatformAuditEventType {
  SUPER_ADMIN_BOOTSTRAPPED
  SUPER_ADMIN_CREDENTIALS_RESET
  PASSWORD_LOGIN_FAILED
  PASSWORD_VERIFIED
  TOTP_FAILED
  SESSION_CREATED
  REFRESH_TOKEN_REUSE_DETECTED
  SESSION_REVOKED
  LOGOUT
  LOGOUT_ALL_DEVICES
}

/// Platform-level administrator. `email` is stored normalized (trimmed, lower-case).
model PlatformAdmin {
  id                   String              @id @db.Uuid
  organizationId       String?             @map("organization_id") @db.Uuid
  email                String              @unique @db.VarChar(254)
  displayName          String              @map("display_name") @db.VarChar(120)
  phone                String?             @db.VarChar(32)
  role                 PlatformAdminRole   @default(SUPER_ADMIN)
  status               PlatformAdminStatus @default(ACTIVE)
  passwordHash         String              @map("password_hash")
  /// AES-256-GCM envelope; the plaintext secret is never stored.
  totpSecretCiphertext String              @map("totp_secret_ciphertext")
  totpEnrolledAt       DateTime?           @map("totp_enrolled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step, used to reject code replay.
  lastTotpTimeStep     BigInt?             @map("last_totp_time_step")
  lastLoginAt          DateTime?           @map("last_login_at") @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  challenges   PlatformAuthChallenge[]
  sessions     PlatformSession[]
  auditEvents  PlatformAuditEvent[]

  assignedLeads    Lead[]             @relation("LeadAssignee")
  createdLeads     Lead[]             @relation("LeadCreator")
  leadActivities   LeadActivity[]
  createdProposals      ProposalDocument[]
  createdServicePackages ServicePackage[]
  createdClients        Client[]
  convertedLeads   Lead[]             @relation("LeadConvertedBy")
  crmAuditEvents   CrmAuditEvent[]
  employeeProfile  Employee?
  createdEmployees Employee[] @relation("EmployeeCreatedBy")
  updatedEmployees Employee[] @relation("EmployeeUpdatedBy")
  managedProjects  Project[]          @relation("ProjectManager")
  createdProjects  Project[]          @relation("ProjectCreator")
  ownedProjectPhases ProjectPhase[]   @relation("PhaseOwner")
  assignedProjectTasks ProjectTask[] @relation("ProjectTaskAssignee")
  memberships          OrganizationMembership[] @relation("MembershipAdmin")
  invitedMemberships   OrganizationMembership[] @relation("MembershipInvitedBy")
  sentInvitations      OrganizationInvitation[] @relation("InvitationInvitedBy")

  @@index([organizationId])
  @@map("platform_admins")
}

/// Short-lived, single-use proof that the password step succeeded.
model PlatformAuthChallenge {
  id             String    @id @db.Uuid
  adminId        String    @map("admin_id") @db.Uuid
  /// SHA-256 of the opaque challenge token held in an HttpOnly cookie.
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  failedAttempts Int       @default(0) @map("failed_attempts")
  ipAddress      String?   @map("ip_address") @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.VarChar(512)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@map("platform_auth_challenges")
}

model PlatformSession {
  id            String                           @id @db.Uuid
  adminId       String                           @map("admin_id") @db.Uuid
  /// SHA-256 of the session-bound CSRF token (double-submit cookie value).
  csrfTokenHash String                           @map("csrf_token_hash") @db.Char(64)
  ipAddress     String?                          @map("ip_address") @db.VarChar(64)
  userAgent     String?                          @map("user_agent") @db.VarChar(512)
  createdAt     DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt  DateTime                         @map("last_active_at") @db.Timestamptz(3)
  expiresAt     DateTime                         @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?                        @map("revoked_at") @db.Timestamptz(3)
  revokedReason PlatformSessionRevocationReason? @map("revoked_reason")

  admin         PlatformAdmin          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  refreshTokens PlatformRefreshToken[]

  @@index([adminId, revokedAt, expiresAt])
  @@map("platform_sessions")
}

/// Every refresh token ever issued for a session. Presenting a rotated token is
/// treated as theft and revokes the whole session.
model PlatformRefreshToken {
  id        String    @id @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session PlatformSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("platform_refresh_tokens")
}

model PlatformAuditEvent {
  id        String                 @id @default(uuid()) @db.Uuid
  adminId   String?                @map("admin_id") @db.Uuid
  type      PlatformAuditEventType
  ipAddress String?                @map("ip_address") @db.VarChar(64)
  userAgent String?                @map("user_agent") @db.VarChar(512)
  metadata  Json?
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([type, createdAt])
  @@map("platform_audit_events")
}

// --- CRM (tenant-scoped business data) ---

model Organization {
  id        String   @id @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  admins      PlatformAdmin[]
  pipelines   Pipeline[]
  stages      PipelineStage[]
  leads       Lead[]
  activities  LeadActivity[]
  clients     Client[]
  proposals       ProposalDocument[]
  servicePackages ServicePackage[]
  projects        Project[]
  projectPhases   ProjectPhase[]
  projectTasks    ProjectTask[]
  employees       Employee[]
  sequences       OrganizationSequence[]
  auditEvents     CrmAuditEvent[]
  memberships     OrganizationMembership[]
  roles           OrganizationRole[]
  invitations     OrganizationInvitation[]

  @@map("organizations")
}

model OrganizationSequence {
  organizationId String @map("organization_id") @db.Uuid
  key            String @db.VarChar(32)
  lastValue      Int    @default(0) @map("last_value")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@map("organization_sequences")
}

enum PipelineStatus {
  ACTIVE
  INACTIVE
}

model Pipeline {
  id             String         @id @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String         @db.VarChar(120)
  description    String         @default("") @db.VarChar(2000)
  status         PipelineStatus @default(ACTIVE)
  isDefault      Boolean        @default(false) @map("is_default")
  sortOrder      Int            @default(0) @map("sort_order")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  leads        Lead[]

  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
  @@index([organizationId, status, sortOrder])
  @@map("pipelines")
}

enum PipelineStageOutcome {
  NONE
  WON
  LOST
}

model PipelineStage {
  id             String               @id @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  pipelineId     String               @map("pipeline_id") @db.Uuid
  name           String               @db.VarChar(120)
  description    String               @default("") @db.VarChar(2000)
  color          String               @default("#64748b") @db.VarChar(7)
  status         PipelineStatus       @default(ACTIVE)
  sortOrder      Int                  @default(0) @map("sort_order")
  outcome        PipelineStageOutcome @default(NONE)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([pipelineId, name])
  @@index([organizationId, pipelineId, sortOrder])
  @@map("pipeline_stages")
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  EMAIL
  SOCIAL
  EVENT
  PARTNER
  OTHER
}

model Lead {
  id                 String       @id @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  referenceNumber    String       @map("reference_number") @db.VarChar(32)
  subject            String       @default("") @db.VarChar(200)
  fullName           String       @map("full_name") @db.VarChar(160)
  companyName        String       @default("") @map("company_name") @db.VarChar(160)
  email              String?      @db.VarChar(254)
  phone              String?      @db.VarChar(32)
  website            String?      @db.VarChar(512)
  source             LeadSource   @default(OTHER)
  pipelineId         String       @map("pipeline_id") @db.Uuid
  stageId            String       @map("stage_id") @db.Uuid
  assignedAdminId    String?      @map("assigned_admin_id") @db.Uuid
  priority           LeadPriority @default(MEDIUM)
  estimatedValue     Decimal      @default(0) @map("estimated_value") @db.Decimal(18, 2)
  currency           String       @default("INR") @db.Char(3)
  expectedCloseDate  DateTime?    @map("expected_close_date") @db.Date
  nextFollowUpDate   DateTime?    @map("next_follow_up_date") @db.Timestamptz(3)
  description        String       @default("") @db.VarChar(4000)
  tags               String[]     @default([])
  createdByAdminId   String       @map("created_by_admin_id") @db.Uuid
  convertedClientId  String?      @unique @map("converted_client_id") @db.Uuid
  convertedAt        DateTime?    @map("converted_at") @db.Timestamptz(3)
  convertedByAdminId String?      @map("converted_by_admin_id") @db.Uuid
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(3)
  kanbanSortOrder    Int          @default(0) @map("kanban_sort_order")
  lastActivityAt     DateTime     @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline         Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage            PipelineStage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  assignedAdmin    PlatformAdmin?     @relation("LeadAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdBy        PlatformAdmin      @relation("LeadCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  convertedClient  Client?            @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  clientFromSource Client?            @relation("ClientSourceLead")
  convertedBy      PlatformAdmin?     @relation("LeadConvertedBy", fields: [convertedByAdminId], references: [id], onDelete: SetNull)
  activities       LeadActivity[]
  proposals        ProposalDocument[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId, archivedAt, createdAt])
  @@index([organizationId, pipelineId, stageId])
  @@index([organizationId, stageId, kanbanSortOrder])
  @@index([organizationId, nextFollowUpDate])
  @@index([organizationId, assignedAdminId])
  @@map("leads")
}

enum LeadActivityType {
  FIRST_CALL
  FOLLOW_UP_CALL
  MEETING
  EMAIL
  NOTE
  TASK
  STAGE_CHANGE
  PROPOSAL_CREATED
  PROPOSAL_STATUS_CHANGE
  LEAD_CONVERTED
}

model LeadActivity {
  id               String           @id @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  leadId           String           @map("lead_id") @db.Uuid
  type             LeadActivityType
  title            String           @db.VarChar(200)
  description      String           @default("") @db.VarChar(4000)
  occurredAt       DateTime         @map("occurred_at") @db.Timestamptz(3)
  dueAt            DateTime?        @map("due_at") @db.Timestamptz(3)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(3)
  metadata         Json?
  createdByAdminId String           @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy    PlatformAdmin @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([organizationId, leadId, occurredAt])
  @@map("lead_activities")
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id               String       @id @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  referenceNumber  String       @map("reference_number") @db.VarChar(32)
  type             ClientType
  name             String       @db.VarChar(160)
  primaryContact   String       @default("") @map("primary_contact") @db.VarChar(160)
  email            String?      @db.VarChar(254)
  phone            String?      @db.VarChar(32)
  website          String?      @db.VarChar(512)
  billingAddress   String       @default("") @map("billing_address") @db.VarChar(1000)
  taxRegistration  String       @default("") @map("tax_registration") @db.VarChar(120)
  status           ClientStatus @default(ACTIVE)
  notes            String       @default("") @db.VarChar(4000)
  sourceLeadId     String?      @unique @map("source_lead_id") @db.Uuid
  createdByAdminId String       @map("created_by_admin_id") @db.Uuid
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         PlatformAdmin      @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  sourceLead        Lead?              @relation("ClientSourceLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  convertedFromLead Lead?              @relation("LeadConvertedClient")
  proposals         ProposalDocument[]
  projects          Project[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId, status, createdAt])
  @@map("clients")
}

enum ProposalDocumentType {
  PROPOSAL
  QUOTATION
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model ProposalDocument {
  id               String               @id @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  documentNumber   String               @map("document_number") @db.VarChar(32)
  type             ProposalDocumentType
  status           ProposalStatus       @default(DRAFT)
  title            String               @db.VarChar(200)
  description      String               @default("") @db.VarChar(4000)
  leadId           String?              @map("lead_id") @db.Uuid
  clientId         String?              @map("client_id") @db.Uuid
  issueDate        DateTime             @map("issue_date") @db.Date
  expiryDate       DateTime?            @map("expiry_date") @db.Date
  currency         String               @default("USD") @db.Char(3)
  subtotal         Decimal              @default(0) @db.Decimal(18, 2)
  discountTotal    Decimal              @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal         Decimal              @default(0) @map("tax_total") @db.Decimal(18, 2)
  grandTotal       Decimal              @default(0) @map("grand_total") @db.Decimal(18, 2)
  notes            String               @default("") @db.VarChar(4000)
  terms            String               @default("") @db.VarChar(4000)
  scopeOfWork      String               @default("") @map("scope_of_work") @db.VarChar(8000)
  paymentTerms     String               @default("") @map("payment_terms") @db.VarChar(4000)
  deliveryTimeline String               @default("") @map("delivery_timeline") @db.VarChar(500)
  clientName       String               @default("") @map("client_name") @db.VarChar(160)
  companyName      String               @default("") @map("company_name") @db.VarChar(160)
  clientPhone      String               @default("") @map("client_phone") @db.VarChar(32)
  clientEmail      String               @default("") @map("client_email") @db.VarChar(254)
  billingAddress   String               @default("") @map("billing_address") @db.VarChar(1000)
  clientGstin      String               @default("") @map("client_gstin") @db.VarChar(15)
  version          Int                  @default(1)
  sourcePackageId  String?              @map("source_package_id") @db.Uuid
  packageSnapshot  Json?                @map("package_snapshot")
  createdByAdminId String               @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead          Lead?                   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client        Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sourcePackage ServicePackage?         @relation(fields: [sourcePackageId], references: [id], onDelete: SetNull)
  createdBy     PlatformAdmin           @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  lineItems     ProposalLineItem[]
  statusHistory ProposalStatusHistory[]
  projects      Project[]

  @@unique([organizationId, documentNumber])
  @@index([organizationId, status, createdAt])
  @@map("proposal_documents")
}

enum ServicePackageStatus {
  ACTIVE
  INACTIVE
}

enum ServicePackageDeliveryUnit {
  DAYS
  WEEKS
  MONTHS
}

enum PackageDiscountType {
  FIXED
  PERCENT
}

model ServicePackage {
  id                      String                 @id @db.Uuid
  organizationId          String                 @map("organization_id") @db.Uuid
  code                    String                 @db.VarChar(32)
  name                    String                 @db.VarChar(160)
  categories              Json                   @default("[]")
  shortDescription        String                 @default("") @map("short_description") @db.VarChar(500)
  detailedDescription     String                 @default("") @map("detailed_description") @db.VarChar(8000)
  status                  ServicePackageStatus   @default(ACTIVE)
  technologyStack         Json                   @default("[]") @map("technology_stack")
  includedPages           Json                   @default("[]") @map("included_pages")
  integrations            Json                   @default("[]")
  adminPanelFeatures      Json                   @default("[]") @map("admin_panel_features")
  hostingDeployment       Json                   @default("[]") @map("hosting_deployment")
  deliveryServices        Json                   @default("[]") @map("delivery_services")
  integrationNotes        String                 @default("") @map("integration_notes") @db.VarChar(4000)
  pageCount               Int?                   @map("page_count")
  basePrice               Decimal                @default(0) @map("base_price") @db.Decimal(18, 2)
  addOns                  Json                   @default("[]") @map("add_ons")
  discountType            PackageDiscountType?   @map("discount_type")
  discountValue           Decimal                @default(0) @map("discount_value") @db.Decimal(18, 2)
  gstRate                 Decimal                @default(18) @map("gst_rate") @db.Decimal(8, 4)
  taxableAmount           Decimal                @default(0) @map("taxable_amount") @db.Decimal(18, 2)
  gstAmount               Decimal                @default(0) @map("gst_amount") @db.Decimal(18, 2)
  finalPrice              Decimal                @default(0) @map("final_price") @db.Decimal(18, 2)
  estimatedDeliveryDuration String               @default("") @map("estimated_delivery_duration") @db.VarChar(120)
  deliveryDurationValue   Int?                   @map("delivery_duration_value")
  deliveryDurationUnit    ServicePackageDeliveryUnit? @map("delivery_duration_unit")
  supportPeriod           String                 @default("") @map("support_period") @db.VarChar(120)
  revisionAllowance       String                 @default("") @map("revision_allowance") @db.VarChar(120)
  termsExclusions         String                 @default("") @map("terms_exclusions") @db.VarChar(4000)
  createdByAdminId        String                 @map("created_by_admin_id") @db.Uuid
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    PlatformAdmin      @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  proposals    ProposalDocument[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("service_packages")
}

model ProposalLineItem {
  id          String   @id @db.Uuid
  proposalId  String   @map("proposal_id") @db.Uuid
  name        String   @db.VarChar(200)
  category    String   @default("") @db.VarChar(120)
  sourcePackageId String? @map("source_package_id") @db.Uuid
  description String   @default("") @db.VarChar(2000)
  quantity    Decimal  @default(1) @db.Decimal(18, 4)
  unit        String   @default("item") @db.VarChar(32)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(18, 2)
  discount    Decimal  @default(0) @db.Decimal(18, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(8, 4)
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(18, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposal ProposalDocument @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, sortOrder])
  @@map("proposal_line_items")
}

model ProposalStatusHistory {
  id               String          @id @default(uuid()) @db.Uuid
  proposalId       String          @map("proposal_id") @db.Uuid
  fromStatus       ProposalStatus? @map("from_status")
  toStatus         ProposalStatus  @map("to_status")
  note             String          @default("") @db.VarChar(1000)
  changedByAdminId String          @map("changed_by_admin_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  proposal ProposalDocument @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@map("proposal_status_history")
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectExecutionLifecycle {
  NOT_PLANNED
  PLANNED
  IN_PRODUCTION
  COMPLETED
}

enum ProjectLifecyclePhase {
  PLANNING
  PRODUCTION
  QA
  DEPLOYMENT
  HANDOVER
  COMPLETED
}

enum ProjectPhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model Project {
  id                      String                @id @db.Uuid
  organizationId          String                @map("organization_id") @db.Uuid
  projectNumber           String                @map("project_number") @db.VarChar(32)
  name                    String                @db.VarChar(200)
  description             String                @default("") @db.VarChar(4000)
  priority                ProjectPriority
  status                  ProjectStatus               @default(ACTIVE)
  executionLifecycle      ProjectExecutionLifecycle   @default(NOT_PLANNED) @map("execution_lifecycle")
  actualProductionStartedAt DateTime?                 @map("actual_production_started_at") @db.Timestamptz(3)
  actualCompletedAt       DateTime?                   @map("actual_completed_at") @db.Timestamptz(3)
  currentPhase            ProjectLifecyclePhase       @default(PLANNING) @map("current_phase")
  clientId                String                @map("client_id") @db.Uuid
  proposalId              String?               @map("proposal_id") @db.Uuid
  projectManagerAdminId   String?               @map("project_manager_admin_id") @db.Uuid
  startDate               DateTime              @map("start_date") @db.Date
  expectedEndDate         DateTime              @map("expected_end_date") @db.Date
  clientName              String                @map("client_name") @db.VarChar(160)
  companyName             String                @default("") @map("company_name") @db.VarChar(160)
  clientPhone             String                @default("") @map("client_phone") @db.VarChar(32)
  clientEmail             String                @default("") @map("client_email") @db.VarChar(254)
  quotationNumberSnapshot String                @default("") @map("quotation_number_snapshot") @db.VarChar(32)
  quotationTitleSnapshot  String                @default("") @map("quotation_title_snapshot") @db.VarChar(200)
  acceptedCommercialValue Decimal?              @map("accepted_commercial_value") @db.Decimal(18, 2)
  currency                String                @default("INR") @db.Char(3)
  scopeAndRequirements    String                @default("") @map("scope_and_requirements") @db.VarChar(8000)
  mainDeliverables        String                @default("") @map("main_deliverables") @db.VarChar(4000)
  acceptanceCriteria      String                @default("") @map("acceptance_criteria") @db.VarChar(4000)
  internalNotes           String                @default("") @map("internal_notes") @db.VarChar(4000)
  createdByAdminId        String                @map("created_by_admin_id") @db.Uuid
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  proposal        ProposalDocument? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  projectManager  PlatformAdmin?    @relation("ProjectManager", fields: [projectManagerAdminId], references: [id], onDelete: SetNull)
  createdBy       PlatformAdmin     @relation("ProjectCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  phases          ProjectPhase[]
  tasks           ProjectTask[]

  @@unique([organizationId, projectNumber])
  @@index([organizationId, status, currentPhase])
  @@index([organizationId, executionLifecycle])
  @@index([organizationId, clientId])
  @@map("projects")
}

model ProjectPhase {
  id               String                @id @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  projectId        String                @map("project_id") @db.Uuid
  phase            ProjectLifecyclePhase   @default(PLANNING)
  name             String                @db.VarChar(200)
  description      String                @default("") @db.VarChar(4000)
  status           ProjectPhaseStatus    @default(NOT_STARTED)
  startDate        DateTime              @map("start_date") @db.Date
  expectedEndDate  DateTime              @map("expected_end_date") @db.Date
  ownerAdminId     String?               @map("owner_admin_id") @db.Uuid
  sortOrder        Int                   @map("sort_order")
  actualStartedAt  DateTime?             @map("actual_started_at") @db.Timestamptz(3)
  actualCompletedAt DateTime?            @map("actual_completed_at") @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        PlatformAdmin? @relation("PhaseOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  tasks        ProjectTask[]

  @@index([organizationId, projectId])
  @@map("project_phases")
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ProjectTask {
  id               String              @id @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  projectId        String              @map("project_id") @db.Uuid
  phaseId          String              @map("phase_id") @db.Uuid
  title            String              @db.VarChar(200)
  description      String              @default("") @db.VarChar(4000)
  status           ProjectTaskStatus   @default(TODO)
  priority         ProjectTaskPriority @default(MEDIUM)
  assigneeAdminId  String?             @map("assignee_admin_id") @db.Uuid
  startDate        DateTime?           @map("start_date") @db.Date
  dueDate          DateTime?           @map("due_date") @db.Date
  labels           String[]            @default([])
  sortOrder        Int                 @map("sort_order")
  actualStartedAt  DateTime?           @map("actual_started_at") @db.Timestamptz(3)
  actualCompletedAt DateTime?          @map("actual_completed_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase        ProjectPhase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assignee     PlatformAdmin? @relation("ProjectTaskAssignee", fields: [assigneeAdminId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId])
  @@index([organizationId, phaseId, sortOrder])
  @@map("project_tasks")
}

enum CrmAuditEventType {
  PIPELINE_CREATED
  PIPELINE_UPDATED
  PIPELINE_DELETED
  STAGE_CREATED
  STAGE_UPDATED
  STAGE_DELETED
  STAGE_REORDERED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_ARCHIVED
  LEAD_RESTORED
  LEAD_DELETED
  LEAD_STAGE_CHANGED
  LEAD_CONVERTED
  CLIENT_CREATED
  CLIENT_UPDATED
  PROPOSAL_CREATED
  PROPOSAL_UPDATED
  PROPOSAL_STATUS_CHANGED
  SERVICE_PACKAGE_CREATED
  SERVICE_PACKAGE_UPDATED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  MEMBER_INVITED
  MEMBER_INVITATION_REVOKED
  MEMBER_INVITATION_ACCEPTED
  MEMBER_UPDATED
  MEMBER_STATUS_CHANGED
  MEMBER_ROLES_CHANGED
  MEMBER_REMOVED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ROLE_PERMISSIONS_UPDATED
}

model CrmAuditEvent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  adminId        String?           @map("admin_id") @db.Uuid
  type           CrmAuditEventType
  entityType     String            @map("entity_type") @db.VarChar(32)
  entityId       String            @map("entity_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  admin        PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("crm_audit_events")
}

enum EmployeeEmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmployeeEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

model Employee {
  id                 String                   @id @db.Uuid
  organizationId     String                   @map("organization_id") @db.Uuid
  employeeCode       String                   @map("employee_code") @db.VarChar(32)
  firstName          String                   @map("first_name") @db.VarChar(80)
  lastName           String                   @map("last_name") @db.VarChar(80)
  displayName        String                   @map("display_name") @db.VarChar(160)
  workEmail          String                   @map("work_email") @db.VarChar(254)
  phone              String                   @db.VarChar(32)
  alternatePhone     String?                  @map("alternate_phone") @db.VarChar(32)
  profileImageUrl    String?                  @map("profile_image_url") @db.VarChar(512)
  jobTitle           String                   @map("job_title") @db.VarChar(120)
  department         String                   @db.VarChar(120)
  employmentType     EmployeeEmploymentType   @map("employment_type")
  employmentStatus   EmployeeEmploymentStatus @default(ACTIVE) @map("employment_status")
  dateOfJoining      DateTime                 @map("date_of_joining") @db.Date
  probationEndDate   DateTime?                @map("probation_end_date") @db.Date
  employmentEndDate  DateTime?                @map("employment_end_date") @db.Date
  workLocation       String?                  @map("work_location") @db.VarChar(160)
  reportingManagerId String?                  @map("reporting_manager_id") @db.Uuid
  notes              String                   @default("") @db.VarChar(4000)
  platformAdminId    String?                  @unique @map("platform_admin_id") @db.Uuid
  deactivatedAt      DateTime?                @map("deactivated_at") @db.Timestamptz(3)
  createdByAdminId   String                   @map("created_by_admin_id") @db.Uuid
  updatedByAdminId   String?                  @map("updated_by_admin_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportingManager Employee?      @relation("EmployeeReportingLine", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports    Employee[]     @relation("EmployeeReportingLine")
  platformAdmin    PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)
  createdBy        PlatformAdmin  @relation("EmployeeCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  updatedBy        PlatformAdmin? @relation("EmployeeUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, workEmail])
  @@unique([organizationId, phone])
  @@index([organizationId, employmentStatus])
  @@index([organizationId, department])
  @@index([organizationId, dateOfJoining])
  @@index([organizationId, updatedAt])
  @@map("employees")
}

// --- Organization access (memberships, roles, permissions) ---

enum OrganizationMembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum OrganizationRoleStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model OrganizationMembership {
  id             String                       @id @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  adminId        String                       @map("admin_id") @db.Uuid
  status         OrganizationMembershipStatus @default(ACTIVE)
  isOwner        Boolean                      @default(false) @map("is_owner")
  invitedByAdminId String?                    @map("invited_by_admin_id") @db.Uuid
  invitedAt      DateTime?                    @map("invited_at") @db.Timestamptz(3)
  acceptedAt     DateTime?                    @map("accepted_at") @db.Timestamptz(3)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  admin        PlatformAdmin @relation("MembershipAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  invitedBy    PlatformAdmin? @relation("MembershipInvitedBy", fields: [invitedByAdminId], references: [id], onDelete: SetNull)
  roleLinks    OrganizationMembershipRole[]

  @@unique([organizationId, adminId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model OrganizationRole {
  id             String                 @id @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  key            String                 @db.VarChar(64)
  name           String                 @db.VarChar(120)
  description    String                 @default("") @db.VarChar(500)
  isSystem       Boolean                @default(false) @map("is_system")
  status         OrganizationRoleStatus @default(ACTIVE)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  OrganizationRolePermission[]
  memberships  OrganizationMembershipRole[]
  invitations  OrganizationInvitationRole[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@map("organization_roles")
}

model OrganizationRolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionKey  String @map("permission_key") @db.VarChar(64)

  role OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("organization_role_permissions")
}

model OrganizationMembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       OrganizationRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("organization_membership_roles")
}

model OrganizationInvitation {
  id               String                       @id @db.Uuid
  organizationId   String                       @map("organization_id") @db.Uuid
  email            String                       @db.VarChar(254)
  tokenHash        String                       @unique @map("token_hash") @db.Char(64)
  status           OrganizationInvitationStatus @default(PENDING)
  expiresAt        DateTime                     @map("expires_at") @db.Timestamptz(3)
  invitedByAdminId String                       @map("invited_by_admin_id") @db.Uuid
  acceptedAt       DateTime?                    @map("accepted_at") @db.Timestamptz(3)
  revokedAt        DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    PlatformAdmin @relation("InvitationInvitedBy", fields: [invitedByAdminId], references: [id], onDelete: Restrict)
  roleLinks    OrganizationInvitationRole[]

  @@index([organizationId, status])
  @@index([organizationId, email])
  @@map("organization_invitations")
}

model OrganizationInvitationRole {
  invitationId String @map("invitation_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  invitation OrganizationInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role       OrganizationRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([invitationId, roleId])
  @@map("organization_invitation_roles")
}
