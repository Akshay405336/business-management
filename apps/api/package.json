{
  "name": "@techwin/api",
  "version": "0.1.0",
  "private": true,
  "description": "Techwin NestJS API (modular monolith).",
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "dev": "pnpm --filter @techwin/validation run build && pnpm run clean && tsc -p tsconfig.build.json && pnpm run \"/^dev:/\"",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --watch-path=dist --watch-path=../../packages/validation/dist --watch-preserve-output dist/main.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "admin:bootstrap": "tsx src/modules/auth/cli/bootstrap-super-admin.ts",
    "admin:bootstrap:prod": "node dist/modules/auth/cli/bootstrap-super-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@techwin/catalog": "workspace:*",
    "@techwin/contracts": "workspace:*",
    "@techwin/validation": "workspace:*",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "nestjs-pino": "5.3.1",
    "otplib": "13.5.0",
    "pg": "8.16.3",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@standard-schema/spec": "1.1.0",
    "@techwin/eslint-config": "workspace:*",
    "@techwin/tsconfig": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
